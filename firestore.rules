rules_version = '2';

// ============================================================================
// FIRESTORE SECURITY RULES - PRIT-KOTAS / SIDU-BPS
// ============================================================================
// Salin isi file ini ke tab "Rules" pada Firestore Database di Firebase
// Console, lalu klik "Publish". Lihat FIREBASE-SETUP.md untuk panduan
// lengkap langkah demi langkah.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------
    // Koleksi "pengaduan"
    // - Siapa saja (termasuk pengunjung yang belum login) boleh membuat
    //   laporan baru (create) dan membaca daftar laporan untuk fitur
    //   Cek Status (read) -- ini diperlukan karena sistem sengaja dibuat
    //   TANPA login/registrasi untuk masyarakat.
    // - Hanya admin yang sudah login (Firebase Authentication) yang boleh
    //   mengubah (update) atau menghapus (delete) data pengaduan, misalnya
    //   saat memperbarui status atau menambahkan tanggapan.
    // -------------------------------------------------------------------
    match /pengaduan/{docId} {
      allow read: if true;
      allow create: if isValidPengaduan();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // -------------------------------------------------------------------
    // Koleksi "saran"
    // - Siapa saja boleh mengirim saran baru (create).
    // - Hanya admin yang boleh membaca daftar seluruh saran di dashboard,
    //   memperbarui, atau menghapusnya. Publik tidak perlu (dan tidak
    //   diberi akses) untuk membaca kembali saran yang sudah dikirim.
    // -------------------------------------------------------------------
    match /saran/{docId} {
      allow read: if isSignedIn();
      allow create: if isValidSaran();
      allow update, delete: if isSignedIn();
    }

    // -------------------------------------------------------------------
    // Koleksi "gratifikasi"
    // - Hanya staf yang sudah login (Firebase Authentication) yang boleh
    //   membaca, membuat, mengubah, atau menghapus laporan anti gratifikasi,
    //   karena data ini hanya diinput manual oleh admin (bukan publik).
    // -------------------------------------------------------------------
    match /gratifikasi/{docId} {
      allow read, create, update, delete: if isSignedIn();
    }

    // -------------------------------------------------------------------
    // Helper functions
    // -------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidPengaduan() {
      let d = request.resource.data;
      return d.keys().hasAll(['nama', 'email', 'kategori', 'materi', 'laporan', 'status', 'tanggal'])
        && d.status in ['Menunggu', 'Diproses', 'Selesai']
        && d.email is string
        && d.laporan is string
        && d.laporan.size() > 0;
    }

    function isValidSaran() {
      let d = request.resource.data;
      return d.keys().hasAll(['nama', 'kategori', 'judul', 'isi', 'tanggal'])
        && d.isi is string
        && d.isi.size() > 0;
    }
  }
}
